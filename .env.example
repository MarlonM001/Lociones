# Copia este archivo a .env.local (que ya está en .gitignore) y pon tu clave real.
# Consíguela en https://console.cloud.google.com/google/maps-apis
# Habilita "Geocoding API" y "Maps JavaScript API", y restringe la clave por
# referente HTTP a tu dominio (y a localhost mientras desarrollas).
VITE_GOOGLE_MAPS_API_KEY=

# Opcional. Solo hace falta si corres el backend aparte en local (server/npm run dev
# en otro puerto). En producción no se usa: frontend y backend viven en el mismo
# deploy de Vercel, así que las peticiones van directo a /api/... sin esta variable.
VITE_API_URL=http://localhost:4000
