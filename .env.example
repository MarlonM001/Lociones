# Copia este archivo a .env.local (que ya está en .gitignore) y pon tu clave real.
# Consíguela en https://console.cloud.google.com/google/maps-apis
# Habilita "Geocoding API" y "Maps JavaScript API", y restringe la clave por
# referente HTTP a tu dominio (y a localhost mientras desarrollas).
VITE_GOOGLE_MAPS_API_KEY=
