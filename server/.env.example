# Copia este archivo a .env (ya está en .gitignore) y completa los valores reales.

PORT=4000

# Cadena de conexión a Postgres. En desarrollo local (Windows) apunta al
# usuario/base creados para este proyecto; en el VPS de Hostinger apuntará al
# Postgres que corra ahí.
DATABASE_URL=postgres://lociones_user:lociones_dev_pw_2026@localhost:5432/lociones

# Secreto para firmar los JWT de sesión. Genera uno propio y largo, nunca uses
# este valor de ejemplo en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por coma (sin espacios).
# Incluye tu URL de Vercel y localhost mientras desarrollas el frontend.
CORS_ORIGIN=http://localhost:5173,https://lociones-sable.vercel.app

# Credenciales del admin que crea `npm run seed`. Nunca se suben al repo ni
# al bundle del cliente — esto es justamente lo que reemplaza al admin
# hardcodeado que tenía el frontend antes.
ADMIN_SEED_NAME=Marlon
ADMIN_SEED_EMAIL=marlon@essencepolar.com
ADMIN_SEED_PASSWORD=cambia-esto-por-una-contrasena-real

# Límites de subida de archivos (deben coincidir con lo que ya validaba el
# frontend: 8MB para fotos de producto, 100MB para videos de referencia).
MAX_IMAGE_SIZE_MB=8
MAX_VIDEO_SIZE_MB=100

# Carpeta donde se guardan los archivos subidos (relativa a server/, o una
# ruta absoluta en el VPS de producción).
UPLOAD_DIR=uploads
