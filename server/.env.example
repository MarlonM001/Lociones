# Copia este archivo a .env (ya está en .gitignore) y completa los valores reales.
# Para desarrollo local: apunta DATABASE_URL al connection string con pooler (Session pooler,
# puerto 5432) del proyecto de Supabase — ya no se usa Postgres local ni túnel de Cloudflare.

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secreto para firmar los JWT de sesión. Genera uno propio y largo, nunca uses
# este valor de ejemplo en producción.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Proyecto de Supabase (Project Settings → API). La service role key nunca se expone al
# cliente ni se sube al repo: solo la usa el backend para subir archivos a Storage.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cambia-esto-por-la-secret-key-del-proyecto

# Credenciales del admin que crea `npm run seed`. Nunca se suben al repo ni
# al bundle del cliente — esto es justamente lo que reemplaza al admin
# hardcodeado que tenía el frontend antes.
ADMIN_SEED_NAME=Marlon
ADMIN_SEED_EMAIL=marlon@essencepolar.com
ADMIN_SEED_PASSWORD=cambia-esto-por-una-contrasena-real

# Límite de subida de fotos (productos, subastas y referencias de entrega),
# bajo el límite de payload de las funciones de Vercel en el plan Hobby (~4.5MB).
MAX_IMAGE_SIZE_MB=4
